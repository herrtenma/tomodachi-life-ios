+
+            // Block conditions (if / loop) are expressions the visitor doesn't yield; calls inside them need
+            // temporaries too (3f609aeb.vs: a call under a condition failed with KeyNotFoundException).
+            AstBlockVisitor visitor = new(function.MainBlock);
+            visitor.BlockEntered += (sender, e) =>
+            {
+                if (e.Block.Condition != null)
+                {
+                    DeclareCallArgTemps(context, e.Block.Condition);
+                }
+            };
+
+            foreach (IAstNode node in visitor.Visit())
+            {
+                DeclareCallArgTemps(context, node);
+            }
+        }
+
+        // nxrt patch: see CodeGenContext.CallArgTemps.
+        private static void DeclareCallArgTemps(CodeGenContext context, IAstNode node)
+        {
+            if (node is AstAssignment assignment)
+            {
+                DeclareCallArgTemps(context, assignment.Source);
+            }
+            else if (node is AstOperation operation)
+            {
+                for (int i = 0; i < operation.SourcesCount; i++)
+                {
+                    DeclareCallArgTemps(context, operation.GetSource(i));
+                }
+
+                if (operation.Inst == IntermediateRepresentation.Instruction.Call)
+                {
+                    (StructuredFunction callee, _) = context.GetFunction(((AstOperand)operation.GetSource(0)).Value);
+
+                    for (int i = 1; i < operation.SourcesCount; i++)
+                    {
+                        if (operation.GetSource(i) is not AstOperand { Type: IntermediateRepresentation.OperandType.LocalVariable })
+                        {
+                            SpvInstruction pointerType = context.TypePointer(StorageClass.Function, context.GetType(callee.GetArgumentType(i - 1)));
+                            SpvInstruction temp = context.Variable(pointerType, StorageClass.Function);
+
+                            context.AddLocalVariable(temp);
+                            context.CallArgTemps[(operation, i)] = temp;
+                        }
+                    }
+                }
+            }
         }
 
